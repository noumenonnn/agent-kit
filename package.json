{
  "name": "pi-token-efficient-starter-kit",
  "version": "2.3.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noumenonnn/agent-kit.git"
  },
  "homepage": "https://github.com/noumenonnn/agent-kit#readme",
  "bugs": {
    "url": "https://github.com/noumenonnn/agent-kit/issues"
  },
  "keywords": [
    "ai-agents",
    "context-engineering",
    "pi",
    "codex",
    "claude-code",
    "opencode",
    "agent-skills"
  ],
  "type": "module",
  "description": "Offline context-efficient project tooling for Pi, Codex, Claude Code and OpenCode",
  "bin": {
    "agent-kit": "scripts/agent-kit.mjs"
  },
  "files": [
    "scripts/",
    "portable/",
    "locales/",
    "project-template/",
    "global/",
    "profiles/",
    "optional/",
    "docs/",
    "*.md",
    "LICENSE",
    "versions.json",
    "verification/*.md",
    "verification/pi-v2.2-smoke.json",
    ".github/**/*.md"
  ],
  "pi": {
    "skills": [
      "./portable/skills",
      "./global/skills"
    ],
    "prompts": [
      "./project-template/.pi/prompts"
    ],
    "extensions": []
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "setup": "node scripts/agent-kit.mjs setup",
    "wizard": "node scripts/agent-kit.mjs wizard",
    "doctor": "node scripts/agent-kit.mjs doctor",
    "test": "node --test",
    "check": "node scripts/check-kit.mjs",
    "context:summary": "node scripts/summarize-context-evals.mjs",
    "integrity:write": "node scripts/integrity.mjs --write",
    "integrity:check": "node scripts/integrity.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:write": "node scripts/check-docs.mjs --write"
  }
}
